---
import '../styles/tokens.generated.css';
import '../styles/fonts.generated.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '中国历史可视化百科' } = Astro.props;

/**
 * 预载 400 字重正文子集。
 *
 * 实测（模拟 4G + 4x CPU，Lighthouse 13.5）：
 *   预载 regular.woff2 → FCP 1.8s / LCP 4.4s
 *   去掉预载          → FCP 4.0s / LCP 4.4s
 * 去掉预载反而更慢——lantern 会把「首屏文本所用的字体」挂进绘制关键链路，
 * 靠 CSS 里的 @font-face 被动发现要晚一个 RTT 才发起请求。
 * 样式已内联，所以预载不会和样式表抢带宽，是纯赚。
 *
 * 500（标题）不预载：它不参与 LCP，避免两张大字体同时争抢带宽。
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const favicon = `${base}/favicon.svg`;
const fontPreload = `${base}/fonts/regular.woff2`;
---

<!doctype html>
<html lang="zh-CN" data-theme="classical">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preload" href={fontPreload} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
