#!/bin/sh
# commit-msg 钩子的入口。
#
# 真实逻辑在仓库内的 scripts/hooks/strip-ai-trailers.mjs —— 用 JS 写，
# 跨平台、可被 node --test 覆盖。这里是薄壳：git 只认可执行文件，不认 .mjs。
#
# 为什么不就地做文本处理：Windows 下 sh 的 sed/grep 行为与版本相关，
# 而 node 是本项目的既定依赖。
#
# 为什么路径要往上找而不是用 "$0" 同目录：.git/hooks 是部署副本，
# 真正的脚本在仓库工作区里。两者不在同一目录。
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd) || exit 1
script="$root/scripts/hooks/strip-ai-trailers.mjs"

# 脚本不在（比如在非工作区环境里跑）就放行，别把提交卡死
[ -f "$script" ] || exit 0

exec node "$script" "$1"
