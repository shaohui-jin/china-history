---
import Base from '../layouts/Base.astro';
import TimelineLayoutB from '../components/timeline/TimelineLayoutB.vue';
import { getTimelineData } from '../lib/content';
import { url } from '../lib/url';

const timeline = await getTimelineData();

/**
 * 全量注入，不再按需加载。
 *
 * 早期画布版需要分片：它要画 sig≥4 的点，还得按世纪补次要事件，
 * 于是有 /data/timeline/<century>.json 这套机制。
 *
 * 现在只有时间轴版，它只用 year / title / significance，不用 summary。
 * 实测全量 142 条事件的标题合计约 9KB，直接注入比维护分片简单得多，
 * 也让「缩放后立刻能看到新点」不用等网络。
 */
const timelineData = {
  ...timeline,
  items: timeline.items.map(({ summary: _s, ...rest }) => rest as (typeof timeline.items)[number]),
};
---

<Base title="时间线 · 史鉴" description="按政权分道的中国历史时间线，支持缩放与框选时间段">
  <header class="topbar">
    <div class="container topbar__inner">
      <a class="topbar__brand" href={url('')}>
        <span class="topbar__mark">史</span>
        <span class="topbar__name">史鉴</span>
      </a>
      <nav class="nav" aria-label="主导航">
        <a href={url('timeline')} aria-current="page">时间线</a>
        <a href={url('graph')}>关系图谱</a>
        <a href={url('search')}>检索</a>
        <a href={url('styleguide')}>设计</a>
      </nav>
    </div>
  </header>

  <main class="container container--wide">
    <div class="page-head">
      <p class="eyebrow">主线</p>
      <h1 class="page-title">中国历史时间线</h1>
      <p class="page-lede">
        先选政权，再沿时间轴看它的大事。横轴可缩放与拖动——同一朝代里事件挤在一起时，
        放大到那一段就能摊开。点任意事件进入详情。
      </p>
    </div>

    <!--
      全端统一用同一个组件。
      早期是「桌面画布泳道 + 移动端纵向列表」两套实现，交互与信息密度都不同，
      维护成本高且观感割裂。现在只有这一种形态。
    -->
    <TimelineLayoutB
      client:only="vue"
      lanes={timeline.lanes}
      items={timelineData.items}
    />
  </main>
</Base>

<style>
.topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: color-mix(in srgb, var(--color-paper) 90%, transparent);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--color-border);
}

.topbar__inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
  min-height: 3.75rem;
  padding-block: var(--sp-2);
}

.topbar__brand {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.topbar__mark {
  width: 1.75rem;
  height: 1.75rem;
  display: grid;
  place-items: center;
  background: var(--color-accent);
  color: var(--color-ink-inverse);
  font-family: var(--font-display);
  border-radius: 1px;
  font-size: var(--fs-sm);
}

.topbar__name {
  font-family: var(--font-display);
  font-size: var(--fs-base);
  font-weight: var(--fw-semibold);
  letter-spacing: 0.08em;
}

.nav {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
  font-family: var(--font-ui);
  font-size: var(--fs-sm);
}

.nav a {
  padding: 0.5rem 0.75rem;
  min-height: 2.25rem;
  display: inline-flex;
  align-items: center;
  border-radius: var(--radius-sm);
  color: var(--color-ink-muted);
}

.nav a:hover,
.nav a[aria-current='page'] {
  color: var(--color-ink-strong);
  background: var(--color-paper-alt);
}

.nav a[aria-current='page'] {
  font-weight: var(--fw-medium);
}

.page-head {
  padding-block: var(--sp-10) var(--sp-6);
}

.page-title {
  font-size: (--fs-3xl);
  font-size: var(--fs-3xl);
  margin-top: var(--sp-2);
}

.page-lede {
  max-width: 44rem;
  margin-top: var(--sp-3);
  font-size: var(--fs-sm);
  color: var(--color-ink-muted);
  line-height: var(--lh-body);
}

.polis {
  margin-block: var(--sp-10) var(--sp-16);
  padding-top: var(--sp-6);
  border-top: 1px dotted var(--color-border);
}

.polis__title {
  font-size: var(--fs-2xs);
  letter-spacing: var(--ls-wider);
  text-transform: uppercase;
  color: var(--color-ink-faint);
  margin-bottom: var(--sp-3);
}

.polis__list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2) var(--sp-5);
}

.polis__item {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  font-size: var(--fs-sm);
}

.polis__bar {
  width: 0.75rem;
  height: 0.25rem;
  border-radius: var(--radius-full);
  opacity: 0.8;
}

.polis__name {
  color: var(--color-ink);
}

.polis__span {
  font-size: var(--fs-2xs);
  color: var(--color-ink-faint);
}
</style>
