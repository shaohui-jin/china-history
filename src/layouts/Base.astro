---
import '../styles/tokens.generated.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 页面级 OG 类型。文章类页面传 'article'，其余默认 'website' */
  ogType?: 'website' | 'article';
}

const { title, description = '中国历史可视化百科', ogType = 'website' } = Astro.props;

/**
 * 不加载 webfont（见 design/tokens.ts 的 fontFamily 注释）。
 *
 * 曾经这里 preload 429 KB 的 regular.woff2，占首屏传输 87%。
 * 现在整站走系统字体，首屏字体请求数为 0，也不再需要 fonts.generated.css。
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const favicon = `${base}/favicon.svg`;

/**
 * canonical 与 OG 的绝对地址。
 *
 * `import.meta.env.SITE` 只在构建时设了 SITE_URL 才存在：
 * - 线上（GitHub Actions）：SITE_URL 由 configure-pages 注入，正常输出
 * - 本地 dev / 未配 SITE_URL 的构建：为 undefined，此时**跳过** canonical
 *   （打一个 undefined 开头的 URL 比不输出更糟）
 */
const site = import.meta.env.SITE;
const canonicalUrl =
  site ? new URL(Astro.url.pathname, site).href : undefined;
---

<!doctype html>
<html lang="zh-CN" data-theme="classical">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph：分享到微信/微博时能出标题与摘要，而不是一行灰字 -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="史鉴" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <slot />
  </body>
</html>
