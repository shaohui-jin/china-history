---
import Base from '../layouts/Base.astro';
import TimelineVertical from '../components/timeline/TimelineVertical.vue';
import TimelineExplorer from '../components/timeline/TimelineExplorer.vue';
import { getTimelineData } from '../lib/content';
import { timelineByBreakpoint } from '../design/pages';
import { url } from '../lib/url';

const timeline = await getTimelineData();

/**
 * 首屏只注入「重大事件 + 最近 300 年内的事件」。
 *
 * 理由：桌面时间线初始是全域视图，此时 LOD 只显示 significance >= 4 的事件，
 * 次要事件在这一缩放下根本画不出来。全量注入等于浪费首屏带宽。
 * 放大到 300 年以内时，TimelineCanvas 会按世纪从
 * /data/timeline/<century>.json 拉取缺失的部分。
 *
 * 手机端（TimelineVertical）**必须传全量条目**：它内部有「展开其余 N 条」的折叠逻辑，
 * 若这里先滤掉 sig<4，组件里的 hiddenCount 会恒为 0，按钮永远不出现。
 *
 * 但 summary 字段可以去掉：它在 props 里占约 25%，只在用户点开某一条时才用得上。
 * 组件会在展开时按世纪从 /data/timeline/<c>.json 现取（见 ensureSummary）。
 * 首页用的是同一套做法，见 index.astro 的 timelineNoSummary。
 */
const initialItems = timeline.items.filter((it) => it.significance >= 4);
const timelineLite = { ...timeline, items: initialItems };
const timelineNoSummary = {
  ...timeline,
  items: timeline.items.map(({ summary: _s, ...rest }) => rest as (typeof timeline.items)[number]),
};
---

<Base title="时间线 · 史鉴" description="按政权分道的中国历史时间线，支持缩放与框选时间段">
  <header class="topbar">
    <div class="container topbar__inner">
      <a class="topbar__brand" href={url('')}>
        <span class="topbar__mark">史</span>
        <span class="topbar__name">史鉴</span>
      </a>
      <nav class="nav" aria-label="主导航">
        <a href={url('timeline')} aria-current="page">时间线</a>
        <a href={url('graph')}>关系图谱</a>
        <a href={url('search')}>检索</a>
        <a href={url('styleguide')}>设计</a>
      </nav>
    </div>
  </header>

  <main class="container container--wide">
    <div class="page-head">
      <p class="eyebrow">主线</p>
      <h1 class="page-title">中国历史时间线</h1>
      <p class="page-lede">
        纵向按政权分道，横向按年铺开。同一时刻并存的政权（匈奴与汉、突厥与唐）各占一道。
        低缩放只显示重大事件，放大后逐级放出次要事件。
      </p>
    </div>

    <!--
      桌面（≥1024）：TimelineExplorer = 画布泳道 + 政权筛选条
      平板与手机（<1024）：纵向列表（自带年代分段与政权 chips）

      为什么平板不用画布：768–1023px 下横向泳道本来就拥挤，
      而且画布必须吃掉触摸事件（touch-action 冲突），
      手指落在画布上页面就滚不动。列表在平板上更实用。

      client:media 而不是 client:only + CSS 隐藏：
      媒体查询不匹配时 Astro 根本不下发这段 JS，
      手机上不会白下载画布组件的 chunk。
      注意这里的媒体查询必须与下方 .only-wide / .only-narrow 的断点一致。
    -->
    <div class="only-wide">
      <TimelineExplorer
        client:media="(min-width: 1024px)"
        config={timelineByBreakpoint.lg}
        data={timelineLite}
        lanes={timeline.lanes}
        lazyLoad={true}
      />
    </div>

    <!-- 平板 + 手机 -->
    <div class="only-narrow">
      <TimelineVertical
        client:media="(max-width: 1023px)"
        data={timelineNoSummary}
        hasSummary={false}
      />
    </div>

    <!--
      政权列表已并入 TimelineExplorer（桌面）与 TimelineVertical（移动端），
      这里不再单独渲染。桌面端可点击筛选，移动端在年代按钮下方有政权 chips。
    -->
  </main>
</Base>

<style>
.topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: color-mix(in srgb, var(--color-paper) 90%, transparent);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--color-border);
}

.topbar__inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
  min-height: 3.75rem;
  padding-block: var(--sp-2);
}

.topbar__brand {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.topbar__mark {
  width: 1.75rem;
  height: 1.75rem;
  display: grid;
  place-items: center;
  background: var(--color-accent);
  color: var(--color-ink-inverse);
  font-family: var(--font-display);
  border-radius: 1px;
  font-size: var(--fs-sm);
}

.topbar__name {
  font-family: var(--font-display);
  font-size: var(--fs-base);
  font-weight: var(--fw-semibold);
  letter-spacing: 0.08em;
}

.nav {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
  font-family: var(--font-ui);
  font-size: var(--fs-sm);
}

.nav a {
  padding: 0.5rem 0.75rem;
  min-height: 2.25rem;
  display: inline-flex;
  align-items: center;
  border-radius: var(--radius-sm);
  color: var(--color-ink-muted);
}

.nav a:hover,
.nav a[aria-current='page'] {
  color: var(--color-ink-strong);
  background: var(--color-paper-alt);
}

.nav a[aria-current='page'] {
  font-weight: var(--fw-medium);
}

.page-head {
  padding-block: var(--sp-10) var(--sp-6);
}

.page-title {
  font-size: (--fs-3xl);
  font-size: var(--fs-3xl);
  margin-top: var(--sp-2);
}

.page-lede {
  max-width: 44rem;
  margin-top: var(--sp-3);
  font-size: var(--fs-sm);
  color: var(--color-ink-muted);
  line-height: var(--lh-body);
}

.only-narrow {
  display: block;
}

.only-wide {
  display: none;
}

/* 断点必须与组件上的 client:media 一致（1024px），否则会出现
   「JS 已加载但容器被隐藏」或「容器可见但组件没挂载」 */
@media (min-width: 1024px) {
  .only-narrow {
    display: none;
  }
  .only-wide {
    display: block;
  }
}

.polis {
  margin-block: var(--sp-10) var(--sp-16);
  padding-top: var(--sp-6);
  border-top: 1px dotted var(--color-border);
}

.polis__title {
  font-size: var(--fs-2xs);
  letter-spacing: var(--ls-wider);
  text-transform: uppercase;
  color: var(--color-ink-faint);
  margin-bottom: var(--sp-3);
}

.polis__list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2) var(--sp-5);
}

.polis__item {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  font-size: var(--fs-sm);
}

.polis__bar {
  width: 0.75rem;
  height: 0.25rem;
  border-radius: var(--radius-full);
  opacity: 0.8;
}

.polis__name {
  color: var(--color-ink);
}

.polis__span {
  font-size: var(--fs-2xs);
  color: var(--color-ink-faint);
}
</style>
