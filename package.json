{
  "name": "shijian-atlas",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/gen-tokens.ts && astro dev",
    "build": "node scripts/gen-tokens.ts && astro build && npm run index",
    "index": "pagefind --site dist",
    "preview": "astro preview",
    "tokens": "node scripts/gen-tokens.ts",
    "validate": "node scripts/validate-content.ts",
    "depth": "node scripts/check-depth.ts",
    "check": "astro check",
    "test": "node --test src/lib/*.test.ts",
    "lint:css": "stylelint \"src/styles/**/*.css\" \"src/**/*.vue\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/vue": "^7.1.6",
    "astro": "^7.4.13",
    "cytoscape": "^3.35.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.6.6",
    "pagefind": "^1.6.0",
    "playwright": "^1.65.1",
    "postcss-html": "^2.0.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "typescript": "^6.0.3"
  }
}
