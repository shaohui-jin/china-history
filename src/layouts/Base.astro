---
import '../styles/tokens.generated.css';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import { inferKind, cleanTitle } from '../lib/report';

interface Props {
  title: string;
  description?: string;
  /** 页面级 OG 类型。文章类页面传 'article'，其余默认 'website' */
  ogType?: 'website' | 'article';
  /**
   * 关掉站点页脚。设计样张页用 —— 那里在展示页面骨架，
   * 页脚会与样张内容互相干扰。
   */
  hideFooter?: boolean;
  /**
   * 不让搜索引擎收录。设计样张页用。
   *
   * 为什么需要：`/styleguide` 是内部设计参考页，已从所有导航入口移除，
   * 但 `sitemap()` 默认会把它列进 sitemap —— 等于主动向搜索引擎公开
   * 一个内部页面。光靠 sitemap 的 filter 不够，页面本身也要声明。
   */
  noindex?: boolean;
}

const {
  title,
  description = '中国历史可视化百科',
  ogType = 'website',
  hideFooter = false,
  noindex = false,
} = Astro.props;

/**
 * 不加载 webfont（见 design/tokens.ts 的 fontFamily 注释）。
 *
 * 曾经这里 preload 429 KB 的 regular.woff2，占首屏传输 87%。
 * 现在整站走系统字体，首屏字体请求数为 0，也不再需要 fonts.generated.css。
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const favicon = `${base}/favicon.svg`;

/**
 * canonical 与 OG 的绝对地址。
 *
 * `import.meta.env.SITE` 只在构建时设了 SITE_URL 才存在：
 * - 线上（GitHub Actions）：SITE_URL 由 configure-pages 注入，正常输出
 * - 本地 dev / 未配 SITE_URL 的构建：为 undefined，此时**跳过** canonical
 *   （打一个 undefined 开头的 URL 比不输出更糟）
 */
const site = import.meta.env.SITE;
const canonicalUrl =
  site ? new URL(Astro.url.pathname, site).href : undefined;

/**
 * 纠错入口的上下文。
 *
 * 在这里统一推断而不是让 8 个页面各传一遍：路径前缀是稳定约定，
 * 新增页面时也不会忘记传。canonicalUrl 在未配 SITE_URL 的本地构建下
 * 为 undefined，退回 Astro.url.href —— issue 里的链接可能指向 localhost，
 * 但那只影响本地调试，线上一定走 canonical。
 */
const reportContext = {
  kind: inferKind(Astro.url.pathname),
  title: cleanTitle(title),
  url: canonicalUrl ?? Astro.url.href,
};
---

<!doctype html>
<html lang="zh-CN" data-theme="classical">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph：分享到微信/微博时能出标题与摘要，而不是一行灰字 -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="史鉴" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <slot />
    {!hideFooter && <SiteFooter context={reportContext} />}
  </body>
</html>
