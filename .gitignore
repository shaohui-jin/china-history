node_modules/
dist/
.astro/
.shots/
.DS_Store

# 字体源文件缓存（已不使用 webfont，此项保留以防有人重新引入自托管字体）
.cache/

# 自托管字体的产物：整站走系统字体后不再生成。
# 加这条是防止旧脚本重新跑一遍后，500KB 的 woff2 被误提交进来。
public/fonts/
src/styles/fonts.generated.css

# 构建产物，由 npm run tokens 生成
src/styles/tokens.generated.css

# 临时文件与本地调试产物
*.log
check.log
preview.log
dev.log
build.log
*.err.log
probe*.mjs
probe*.cjs
dbg*.mjs
tmp-*.cjs
tmp-*.mjs
scan-chars.mjs
fix-links.mjs
display-charset.txt
lh-mobile.json
lh-mobile2.json
lh-mobile-*.json
lh-*.json

# Lighthouse 基线快照需要留档，放在 docs/baseline/ 下，不受上面规则影响
!/docs/baseline/*.json

/.idea/.gitignore
/.idea/history.iml
/.idea/modules.xml
/.idea/vcs.xml
/.idea/
